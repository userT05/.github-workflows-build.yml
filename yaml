name: Android Build Cloud

on:
  push:
    branches: [ master, main ]
  workflow_dispatch: # يتيح لك تشغيل البناء يدوياً بنقرة زر

jobs:
  build:
    runs-on: ubuntu-latest

    steps:
    - name: Checkout Source Code
      uses: actions/checkout@v4

    - name: Set up Java Environment
      uses: actions/setup-java@v4
      with:
        distribution: 'zulu' # توزيعة معتمدة وجاهزة من الجافا
        java-version: '17'   # الإصدار المطلق لبناء المشروع

    - name: Change Android Gradle Permissions
      run: chmod +x gradlew

    - name: Assemble Debug APK
      run: ./gradlew assembleDebug

    - name: Upload Finished APK Artifact
      uses: actions/upload-artifact@v4
      with:
        name: DroidFS-Debug-APK
        path: app/build/outputs/apk/debug/*.apk
